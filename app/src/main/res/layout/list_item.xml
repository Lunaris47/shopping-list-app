<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_dark">

    <View
        android:id="@+id/completedDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/accent_violet_light"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/itemCheckbox"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_square_outline"
            android:contentDescription="Toggle item"/>

        <TextView
            android:id="@+id/itemText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:paddingStart="8dp"/>

        <ImageButton
            android:id="@+id/reminderButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Set reminder"
            android:src="@drawable/ic_bell_outline"
            app:tint="@color/text_secondary"
            android:layout_marginStart="8dp"/>

        <ImageView
            android:id="@+id/itemDragHandle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_drag_handle"
            android:contentDescription="Drag to reorder"
            app:tint="@color/text_secondary"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <View
        android:id="@+id/rowDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_dark"
        android:layout_marginStart="16dp"/>

</LinearLayout>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MyFirstApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:colorBackground">@color/background_dark</item>

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/accent_violet</item>
        <item name="colorPrimaryVariant">@color/surface_dark</item>
        <item name="colorOnPrimary">@color/text_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorSecondaryVariant">@color/accent_green</item>
        <item name="colorOnSecondary">@color/background_dark</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/surface_dark</item>

        <!-- Card background -->
        <item name="cardBackgroundColor">@color/card_dark</item>

    </style>
</resources>